DATABASE_URL=postgresql://job_seeker:job_seeker@db:5432/job_seeker
REDIS_URL=redis://redis:6379/0
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=0
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8021,http://127.0.0.1:8021
JOB_SEEKER_DATA_DIR=/app/data
OPENAI_API_KEY=
BRAVE_SEARCH_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

DJANGO_DEBUG=0
FORTH_PUBLIC_URL=http://localhost:8021
DJANGO_TRUST_PROXY_HEADERS=0
# Optional first-run administrator; never use a shared default password.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
# Local stdio MCP only; remote clients use browser-based OAuth.
FORTH_MCP_USERNAME=
FORTH_MCP_PASSWORD=

# Optional: reuse existing Docker volumes when migrating an installation.
# FORTH_DB_VOLUME=forth_db_data
# FORTH_REDIS_VOLUME=forth_redis_data

# Estimated gross usage costs in USD; set Brave's rate to match your plan.
BRAVE_COST_PER_1000_REQUESTS=5
# Optional model rates per million tokens: [input, cached input, output].
OPENAI_USAGE_RATES_JSON={}

# Optional Fernet key; otherwise Forth creates a private key in its persistent data volume.
ACCOUNT_ENCRYPTION_KEY=

# External beta access and account recovery (never commit real credentials).
FORTH_BETA_INVITE_CODE=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@example.com
SECURE_HSTS_SECONDS=0
