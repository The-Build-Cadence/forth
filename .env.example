DATABASE_URL=postgresql://job_seeker:job_seeker@db:5432/job_seeker
REDIS_URL=redis://redis:6379/0
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=0
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8021,http://127.0.0.1:8021
JOB_SEEKER_DATA_DIR=/app/data
OPENAI_API_KEY=
BRAVE_SEARCH_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: reuse existing Docker volumes when migrating an installation.
# FORTH_DB_VOLUME=forth_db_data
# FORTH_REDIS_VOLUME=forth_redis_data
